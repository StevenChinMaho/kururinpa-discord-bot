{
  "mcpServers": {
    "calculator": {
      "command": "python",
      "args": ["-m", "mcp_server_calculator"]
    },
    "searxng": {
      "command": "deno",
      "args": ["run", "-A", "npm:mcp-searxng@2.7.0"],
