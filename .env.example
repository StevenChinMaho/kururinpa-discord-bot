DISCORD_TOKEN=貼上你的 Bot Token
# 你的 Discord 伺服器 ID（右鍵伺服器 → 複製伺服器 ID，需開啟開發者模式），填了 slash 指令會立即出現
GUILD_ID=
# 佇列空了幾秒後自動離開語音
IDLE_TIMEOUT=300
# 播放清單一次最多加入幾首
MAX_PLAYLIST=50
# 本地 AI（llama.cpp）API 位址，留空則不啟用聊天功能
LLAMA_API_URL=http://192.168.0.66:8000/v1
# 本地 AI API Key，若伺服器沒設 key 可留空
LLAMA_API_KEY=
# 聊天時讀取頻道最近幾則訊息當上下文
CHAT_HISTORY=20
# 回覆前先思考：較慢但比較聰明（true / false）
CHAT_THINKING=true
# 思考力度：xhigh（仔細驗證，預設）/ medium（不額外指示）/ low（簡短思考）
CHAT_REASONING_EFFORT=xhigh
# 思考預算：最多思考幾個 token，到了就強制開始回答（約 21 token/秒，1024 ≈ 50 秒）
CHAT_THINKING_BUDGET=1024
# 自訂機器人個性（可留空用預設），{name} 會換成機器人名稱
CHAT_SYSTEM_PROMPT=
# MCP server 設定檔（工具：網路搜尋、計算機…），留空或檔案不存在就不載入
MCP_CONFIG=/app/mcp_servers.json
# SearXNG 的 secret key，產生方式：openssl rand -hex 32
SEARXNG_SECRET=
# 時區（讓 AI 知道現在幾點）
TZ=Asia/Taipei
