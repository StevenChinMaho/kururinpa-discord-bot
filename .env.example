DISCORD_TOKEN=貼上你的 Bot Token
# 你的 Discord 伺服器 ID（右鍵伺服器 → 複製伺服器 ID，需開啟開發者模式），填了 slash 指令會立即出現
GUILD_ID=
# 佇列空了幾秒後自動離開語音
IDLE_TIMEOUT=300
# 播放清單一次最多加入幾首
MAX_PLAYLIST=50
# 本地 AI（llama.cpp）API 位址，留空則不啟用聊天功能
LLAMA_API_URL=http://192.168.0.66:8000/v1
# 本地 AI API Key，若伺服器沒設 key 可留空
LLAMA_API_KEY=
# 聊天時讀取頻道最近幾則訊息當上下文
CHAT_HISTORY=20
# 自訂機器人個性（可留空用預設），{name} 會換成機器人名稱
CHAT_SYSTEM_PROMPT=